{
  "name": "@moyue/document-kit",
  "version": "2.2.13",
  "type": "module",
  "license": "MIT",
  "description": "SCHEMA: Portable ChatGPT-style documents, safe imports and a dual-theme React renderer",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "FORMAT.md",
    "document.schema.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/index.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "maplibre-gl": "^6.13.0",
    "dompurify": "^3.4.17",
    "fflate": "^0.8.3",
    "zod": "^4.4.3",
    "echarts": "^6.1.0",
    "mermaid": "^12.2.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.22",
    "lucide-react": "^0.562.0",
    "react-markdown": "^9.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  }
}
